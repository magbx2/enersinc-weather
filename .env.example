# Two-City Weather Comparison Dashboard - optional configuration.
# Every value below has a safe local default in docker-compose.yml, so a clean
# checkout boots with `docker compose up` and this file absent.
#
# An empty OPENWEATHER_API_KEY is a supported degraded mode: the stack starts,
# health reports provider_configured=false, and the API serves stored readings
# marked stale. It is not a failure.

# PostgreSQL
POSTGRES_DB=weather
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather

# Redis (cache, Channels group layer and Celery broker)
REDIS_URL=redis://redis:6379/0

# External weather provider
OPENWEATHER_API_KEY=YOUR_API_KEY
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# Django
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=false
BACKEND_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Weather data chat (LiteLLM). The chat is optional: an empty LLM_API_KEY is a
# supported degraded mode and never blocks startup or the weather dashboard.
# LLM_MODEL accepts any LiteLLM model identifier, e.g. "gpt-4o-mini",
# "anthropic/claude-3-5-sonnet" or "openrouter/meta-llama/llama-3.1-70b-instruct".
# Changing it changes the provider/model with no code change.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=4
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=YOUR_KEY